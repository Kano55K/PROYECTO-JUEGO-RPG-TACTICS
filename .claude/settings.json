{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(addons/gdUnit4/runtest.cmd *)"
    ],
    "ask": [
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git * main)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Edit(docs/00_Vision.md)",
      "Edit(docs/Sistema.md)",
      "Edit(docs/Mundo.md)",
      "Edit(docs/Arquitectura.md)",
      "Edit(docs/Brief*)",
      "Edit(datos/textos/**)"
    ]
  }
}