{
  "title": "Reglas numéricas del combate",
  "description": "Sistema.md 10.1 a 10.7, 11.3 a 11.7 y 8.2. Todo número del combate que no está en las fichas, la balanza, el sellado o los costos.",
  "type": "object",
  "required": [
    "despliegue_filas",
    "danio_minimo",
    "afinidad_danio_plano",
    "combo",
    "incidente",
    "encono",
    "cobardia",
    "afines_contra_cobardia",
    "obediencia",
    "salvajes",
    "enfermedad_danio_pct",
    "huida_salvaje",
    "alcance_sellar",
    "alcance_guardar_caida",
    "vida_tras_caida",
    "vida_al_guardar_caida",
    "vida_al_resellar"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_nota": {
      "$ref": "comunes.schema.json#/$defs/nota"
    },
    "despliegue_filas": {
      "type": "integer",
      "minimum": 1
    },
    "danio_minimo": {
      "type": "integer",
      "minimum": 0
    },
    "afinidad_danio_plano": {
      "type": "integer"
    },
    "combo": {
      "type": "object",
      "required": [
        "sin_relacion_pct",
        "afines_pct",
        "divisor_por_eslabon"
      ],
      "additionalProperties": false,
      "properties": {
        "sin_relacion_pct": {
          "type": "integer"
        },
        "afines_pct": {
          "type": "integer"
        },
        "divisor_por_eslabon": {
          "type": "integer",
          "minimum": 1,
          "description": "Cada eslabón vale el anterior dividido esto, redondeado hacia abajo"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "incidente": {
      "type": "object",
      "description": "Sistema.md 10.4. Distraerse o atacar depende del tramo de obediencia (5.4): es comportamiento, no dato",
      "required": [
        "base_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "base_pct": {
          "$ref": "comunes.schema.json#/$defs/pct"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "encono": {
      "type": "object",
      "required": [
        "base_pct",
        "por_punto_pct",
        "max_puntos",
        "danio_plano_por_punto"
      ],
      "additionalProperties": false,
      "properties": {
        "base_pct": {
          "$ref": "comunes.schema.json#/$defs/pct"
        },
        "por_punto_pct": {
          "$ref": "comunes.schema.json#/$defs/pct"
        },
        "max_puntos": {
          "type": "integer",
          "minimum": 0
        },
        "danio_plano_por_punto": {
          "type": "integer"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "cobardia": {
      "type": "object",
      "required": [
        "base_pct",
        "maestro_adyacente_pts",
        "danio_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "base_pct": {
          "$ref": "comunes.schema.json#/$defs/pct"
        },
        "maestro_adyacente_pts": {
          "$ref": "comunes.schema.json#/$defs/puntos"
        },
        "danio_pct": {
          "$ref": "comunes.schema.json#/$defs/puntos"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "afines_contra_cobardia": {
      "description": "PROPUESTA de Sistema.md 10.6; solo rige con el toggle del escenario",
      "type": "object",
      "required": [
        "por_afin_pts",
        "tope_pts",
        "minimo_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "por_afin_pts": {
          "$ref": "comunes.schema.json#/$defs/puntos"
        },
        "tope_pts": {
          "$ref": "comunes.schema.json#/$defs/puntos"
        },
        "minimo_pct": {
          "$ref": "comunes.schema.json#/$defs/pct"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "obediencia": {
      "description": "Sistema.md 5.4. 'leal' rige desde el umbral de rescate (tablas/balanza.json); 'baja', debajo del piso de Neutral (tablas/lealtad.json neutral_desde): los mismos cortes que los estados de lealtad (P-003)",
      "type": "object",
      "required": [
        "leal",
        "baja"
      ],
      "additionalProperties": false,
      "properties": {
        "leal": {
          "type": "object",
          "required": [
            "encono_pts",
            "cobardia_pts"
          ],
          "additionalProperties": false,
          "properties": {
            "encono_pts": {
              "type": "integer"
            },
            "cobardia_pts": {
              "type": "integer"
            },
            "_nota": {
              "$ref": "comunes.schema.json#/$defs/nota"
            }
          }
        },
        "baja": {
          "type": "object",
          "required": [
            "encono_pts",
            "cobardia_pts"
          ],
          "additionalProperties": false,
          "properties": {
            "encono_pts": {
              "type": "integer"
            },
            "cobardia_pts": {
              "type": "integer"
            },
            "_nota": {
              "$ref": "comunes.schema.json#/$defs/nota"
            }
          }
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "salvajes": {
      "description": "Sistema.md 10.7: sin lealtad, se tratan como el tramo indicado de 5.4 y sin Arrimo",
      "type": "object",
      "required": [
        "tramo_obediencia"
      ],
      "additionalProperties": false,
      "properties": {
        "tramo_obediencia": {
          "enum": [
            "leal",
            "neutral",
            "baja"
          ]
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "enfermedad_danio_pct": {
      "$ref": "comunes.schema.json#/$defs/puntos"
    },
    "huida_salvaje": {
      "type": "object",
      "required": [
        "umbral_vida_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "umbral_vida_pct": {
          "$ref": "comunes.schema.json#/$defs/pct"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "alcance_sellar": {
      "type": "integer",
      "minimum": 0
    },
    "alcance_guardar_caida": {
      "type": "integer",
      "minimum": 0
    },
    "vida_tras_caida": {
      "type": "integer",
      "minimum": 1,
      "description": "Al levantarse tras ganar (Sistema.md 11.5)"
    },
    "vida_al_guardar_caida": {
      "type": "integer",
      "minimum": 1,
      "description": "La vida con la que queda una caída que el Maestro guarda (Sistema.md 11.5, T27)"
    },
    "vida_al_resellar": {
      "type": "integer",
      "minimum": 1,
      "description": "La vida con la que queda guardada la atacante nocturna resellada (Sistema.md 4.4 y 9.3, T30; P-046)"
    }
  }
}
