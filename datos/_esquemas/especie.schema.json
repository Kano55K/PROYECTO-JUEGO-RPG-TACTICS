{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ficha de especie",
  "description": "Sistema.md 11.2, 4.3 y 11.7. Una ficha por archivo en datos/especies/. Lo de 0b (apetito, preferencias, habilidades) entra como campos nuevos.",
  "type": "object",
  "required": [
    "id",
    "rol",
    "rango",
    "sellable",
    "vida",
    "danio",
    "movimiento",
    "alcance",
    "turnos",
    "rasgo",
    "huida_pct"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_nota": {
      "type": "string"
    },
    "id": {
      "$ref": "comunes.schema.json#/$defs/id"
    },
    "rol": {
      "enum": [
        "trabajo",
        "combate",
        "mixto"
      ]
    },
    "rango": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "sellable": {
      "type": "boolean",
      "description": "false = no se sella ni se domestica, sin importar la balanza (Tasajero, 4.3)"
    },
    "vida": {
      "type": "integer",
      "minimum": 1
    },
    "danio": {
      "type": "integer",
      "minimum": 0
    },
    "movimiento": {
      "type": "integer",
      "minimum": 0
    },
    "alcance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "turnos": {
      "description": "Una entrada por turno en la ronda. El Tasajero tiene dos (Caza y Cuenta).",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "velocidad"
        ],
        "additionalProperties": false,
        "properties": {
          "velocidad": {
            "type": "integer",
            "minimum": 0
          },
          "marca": {
            "type": "string",
            "description": "Clave de texto de la marca en la cola (ej.: caza, cuenta)"
          },
          "_nota": {
            "type": "string"
          }
        }
      }
    },
    "rasgo": {
      "$ref": "#/$defs/rasgo"
    },
    "huida_pct": {
      "$ref": "comunes.schema.json#/$defs/pct"
    }
  },
  "$defs": {
    "rasgo": {
      "description": "id = nombre (clave de texto rasgo.<id>). efecto = comportamiento programado; sus números van acá.",
      "type": "object",
      "required": [
        "id",
        "efecto"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "comunes.schema.json#/$defs/id"
        },
        "efecto": {
          "enum": [
            "ninguno",
            "accion_defensa",
            "reduccion_plana",
            "primer_ataque"
          ]
        },
        "danio_recibido_pct": {
          "type": "integer",
          "minimum": -100,
          "maximum": 0
        },
        "inmovil": {
          "type": "boolean"
        },
        "danio_recibido_plano": {
          "type": "integer",
          "maximum": 0
        },
        "danio_plano": {
          "type": "integer",
          "minimum": 0
        },
        "_nota": {
          "type": "string"
        }
      }
    }
  }
}
