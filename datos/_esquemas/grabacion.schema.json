{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combate grabado",
  "description": "Arquitectura.md A.6. Contexto + semilla + decisiones del jugador. Las tiradas no se guardan: salen de la semilla. Reproducirlo da el mismo registro, siempre que huella_datos coincida.",
  "type": "object",
  "required": [
    "contexto_id",
    "semilla",
    "huella_datos",
    "acciones"
  ],
  "additionalProperties": false,
  "properties": {
    "contexto_id": {
      "$ref": "comunes.schema.json#/$defs/id"
    },
    "semilla": {
      "type": "integer"
    },
    "huella_datos": {
      "type": "string",
      "description": "Hash de los archivos de datos al grabar. Si cambió, el reproductor avisa en vez de mostrar un falso error"
    },
    "acciones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unidad",
          "tipo"
        ],
        "additionalProperties": false,
        "properties": {
          "unidad": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "tipo": {
            "enum": [
              "despliegue",
              "mover",
              "atacar",
              "hechizo",
              "sellar",
              "guardar",
              "guardar_caida",
              "invocar",
              "erizarse",
              "esperar",
              "secundar",
              "huir",
              "fin_turno",
              "destino_atacante"
            ]
          },
          "destino": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "objetivo": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "hechizo": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "modo": {
            "enum": [
              "empujar",
              "atraer"
            ]
          },
          "aliado": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "opcion": {
            "enum": [
              "perdonar",
              "sellar",
              "comer"
            ]
          },
          "_nota": {
            "type": "string"
          }
        }
      }
    },
    "_nota": {
      "type": "string"
    }
  }
}
