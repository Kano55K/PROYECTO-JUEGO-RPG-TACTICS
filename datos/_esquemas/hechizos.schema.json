{
  "title": "Hechizos",
  "description": "Sistema.md 1.6. geometria y efecto son comportamientos programados; los números van acá.",
  "type": "object",
  "required": [
    "hechizos"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_nota": {
      "$ref": "comunes.schema.json#/$defs/nota"
    },
    "hechizos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "costo",
          "alcance",
          "geometria",
          "efecto",
          "es_ataque"
        ],
        "additionalProperties": false,
        "properties": {
          "_nota": {
            "$ref": "comunes.schema.json#/$defs/nota"
          },
          "id": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "costo": {
            "type": "integer",
            "minimum": 0
          },
          "alcance": {
            "type": "integer",
            "minimum": 0
          },
          "incluye_si_mismo": {
            "type": "boolean"
          },
          "geometria": {
            "enum": [
              "distancia_libre",
              "linea_bloqueo_enemigas",
              "adyacente"
            ]
          },
          "efecto": {
            "enum": [
              "danio",
              "empuje",
              "cura"
            ]
          },
          "base": {
            "description": "D-010: el efecto vale base + por_poder × Poder",
            "type": "integer",
            "minimum": 0
          },
          "por_poder": {
            "description": "D-010: lo que suma cada punto de Poder. Solo en los hechizos que escalan con Poder (Sistema.md 1.6)",
            "type": "integer",
            "minimum": 0
          },
          "es_ataque": {
            "type": "boolean",
            "description": "true = cuenta como eslabón y le aplican los modificadores de daño (11.4)"
          },
          "modos": {
            "type": "array",
            "items": {
              "enum": [
                "empujar",
                "atraer"
              ]
            }
          },
          "casillas": {
            "type": "integer",
            "minimum": 1
          },
          "danio_choque": {
            "type": "integer",
            "minimum": 0
          },
          "afecta_caidas": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
