{
  "title": "Resultado de combate",
  "description": "Arquitectura.md A.7. Salida del combate. La pantalla de resultado solo lo muestra; en 0b el loop lo aplica a la partida. No es un archivo que se edite: lo escribe el núcleo (ResultadoCombate, T12). Los campos de tareas futuras van en null o lista vacía; su description dice qué tarea los llena.",
  "type": "object",
  "required": [
    "contexto_id",
    "semilla",
    "desenlace",
    "rondas",
    "maestro_caido",
    "rescatista",
    "permadeath",
    "maestro",
    "unidades",
    "levantadas",
    "muertas",
    "capturas",
    "lealtad_cambios",
    "pergaminos",
    "atacante_pendiente",
    "metricas"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_nota": {
      "$ref": "comunes.schema.json#/$defs/nota"
    },
    "contexto_id": {
      "$ref": "comunes.schema.json#/$defs/id"
    },
    "semilla": {
      "type": "integer"
    },
    "desenlace": {
      "description": "Los nombres de FinCombate y del evento fin del registro. huida: T28",
      "enum": [
        "victoria",
        "derrota_por_caida",
        "huida"
      ]
    },
    "rondas": {
      "type": "integer",
      "minimum": 0
    },
    "maestro_caido": {
      "type": "boolean"
    },
    "rescatista": {
      "description": "id de la rescatista. T12: null. Lo llena T29",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]+$"
    },
    "permadeath": {
      "description": "T12: null. Lo llena T29",
      "type": [
        "boolean",
        "null"
      ]
    },
    "maestro": {
      "type": "object",
      "required": [
        "vida",
        "posicion",
        "mana",
        "hambre"
      ],
      "additionalProperties": false,
      "properties": {
        "vida": {
          "type": "integer",
          "minimum": 0
        },
        "posicion": {
          "$ref": "comunes.schema.json#/$defs/posicion"
        },
        "mana": {
          "description": "Sistema.md 2.1 (T21): el mana del Maestro al terminar el combate",
          "type": "integer",
          "minimum": 0
        },
        "hambre": {
          "type": "integer"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "unidades": {
      "description": "Estado final de cada criatura, en el orden del Plantel",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "especie",
          "bando",
          "estado",
          "vida",
          "lealtad",
          "hambre",
          "posicion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "especie": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "bando": {
            "enum": [
              "tribu",
              "enemiga"
            ]
          },
          "estado": {
            "enum": [
              "suelta",
              "guardada",
              "caida",
              "fuera",
              "muerta"
            ]
          },
          "vida": {
            "type": "integer",
            "minimum": 0
          },
          "lealtad": {
            "description": "null en las enemigas",
            "type": [
              "integer",
              "null"
            ]
          },
          "hambre": {
            "description": "Final, con el hambre de combate (Sistema.md 7.2, T14). null en las enemigas",
            "type": [
              "integer",
              "null"
            ]
          },
          "posicion": {
            "description": "null si no está en el tablero",
            "$ref": "comunes.schema.json#/$defs/posicion"
          },
          "_nota": {
            "$ref": "comunes.schema.json#/$defs/nota"
          }
        }
      }
    },
    "levantadas": {
      "description": "ids de las caídas de la tribu que se levantaron (victoria)",
      "type": "array",
      "items": {
        "$ref": "comunes.schema.json#/$defs/id"
      }
    },
    "muertas": {
      "description": "ids de las caídas de la tribu que murieron (derrota)",
      "type": "array",
      "items": {
        "$ref": "comunes.schema.json#/$defs/id"
      }
    },
    "capturas": {
      "description": "T12: lista vacía. La llenan T24 (sellar) y T30 (resellar)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "especie",
          "camino",
          "lealtad"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "especie": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "camino": {
            "enum": [
              "combate",
              "resellado"
            ]
          },
          "lealtad": {
            "type": "integer"
          },
          "_nota": {
            "$ref": "comunes.schema.json#/$defs/nota"
          }
        }
      }
    },
    "lealtad_cambios": {
      "description": "Lo que devuelve el acumulador de lealtad: por criatura, antes, cambio recortado una vez y después, con cada anotación y su motivo",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "antes",
          "cambio",
          "despues",
          "anotaciones"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "antes": {
            "type": "integer"
          },
          "cambio": {
            "type": "integer"
          },
          "despues": {
            "type": "integer"
          },
          "anotaciones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cambio",
                "motivo"
              ],
              "additionalProperties": false,
              "properties": {
                "cambio": {
                  "type": "integer"
                },
                "motivo": {
                  "description": "Las claves de tablas/lealtad.json eventos (P-019)",
                  "enum": [
                    "victoria",
                    "muerte_en_el_grupo",
                    "muerte_en_el_grupo_afines",
                    "rescate",
                    "perdon_a_leales",
                    "comer_atacante"
                  ]
                },
                "_nota": {
                  "$ref": "comunes.schema.json#/$defs/nota"
                }
              }
            }
          },
          "_nota": {
            "$ref": "comunes.schema.json#/$defs/nota"
          }
        }
      }
    },
    "pergaminos": {
      "type": "object",
      "required": [
        "en_blanco",
        "ardidos"
      ],
      "additionalProperties": false,
      "properties": {
        "en_blanco": {
          "type": "integer",
          "minimum": 0
        },
        "ardidos": {
          "description": "ids de los pergaminos que ardieron en este combate (como el evento cierre del registro)",
          "type": "array",
          "items": {
            "$ref": "comunes.schema.json#/$defs/id"
          }
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "atacante_pendiente": {
      "description": "id de la atacante nocturna caída al terminar, que espera la decisión del Maestro (perdonar, sellar, comer: T30); null si no hay",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]+$"
    },
    "metricas": {
      "description": "Sistema.md 11.9, Métricas por combate (T23, D-011): las calcula MetricasCombate desde el registro y el escenario. Solo enteros, null y listas: un promedio va como suma y cantidad. Las alarmas, los umbrales y el agregado de 10 partidas son de T33",
      "type": "object",
      "required": [
        "rondas",
        "secundar",
        "eslabones",
        "incidentes",
        "encono",
        "cobardia",
        "sellados",
        "capturas_perdidas",
        "caidas",
        "caidas_guardadas",
        "muertes",
        "rescate",
        "distancia_maestro",
        "activas"
      ],
      "additionalProperties": false,
      "properties": {
        "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
        "rondas": {
          "description": "Métrica 1. totales: la última ronda; primer_ataque: la ronda del primer evento ataque (Martillazo y golpe de incidente incluidos; el choque de la Lanzadera no), o null; de_pelea: desde el primer ataque hasta la última, inclusive (0 sin ataques)",
          "type": "object",
          "required": ["totales", "primer_ataque", "de_pelea"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "totales": { "$ref": "#/$defs/conteo" },
            "primer_ataque": { "type": ["integer", "null"], "minimum": 0 },
            "de_pelea": { "$ref": "#/$defs/conteo" }
          }
        },
        "secundar": {
          "description": "Métrica 2: eventos secundar",
          "type": "object",
          "required": ["usos"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "usos": { "$ref": "#/$defs/conteo" }
          }
        },
        "eslabones": {
          "description": "Métrica 3: solo las cadena_cortada de 2 eslabones o más. Promedio = suma / cadenas",
          "type": "object",
          "required": ["cadenas", "suma", "maximo"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "cadenas": { "$ref": "#/$defs/conteo" },
            "suma": { "$ref": "#/$defs/conteo" },
            "maximo": { "$ref": "#/$defs/conteo" }
          }
        },
        "incidentes": {
          "description": "Métrica 4, por bando (el Maestro va con la tribu)",
          "type": "object",
          "required": ["tribu", "enemigas"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "tribu": { "$ref": "#/$defs/incidentes_bando" },
            "enemigas": { "$ref": "#/$defs/incidentes_bando" }
          }
        },
        "encono": {
          "description": "Métrica 5: chequeo_rival con resultado enconada (también las seguras, sin tirada), por bando",
          "type": "object",
          "required": ["tribu", "enemigas"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "tribu": { "$ref": "#/$defs/conteo" },
            "enemigas": { "$ref": "#/$defs/conteo" }
          }
        },
        "cobardia": {
          "description": "Métrica 6: tiradas de cobardía por bando",
          "type": "object",
          "required": ["tribu", "enemigas"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "tribu": { "$ref": "#/$defs/cobardia_bando" },
            "enemigas": { "$ref": "#/$defs/cobardia_bando" }
          }
        },
        "sellados": {
          "description": "Métrica 7 (sellados intentados y logrados, con la probabilidad mostrada). T23: null. La llena T24",
          "type": "null"
        },
        "capturas_perdidas": {
          "description": "Métrica 8 (por huida en su turno y por llegar a 0). T23: null. La llena T25",
          "type": "null"
        },
        "caidas": {
          "description": "Métrica 9: cada evento estado que pasa a caida (o a caido, el Maestro: P-043), en orden",
          "type": "array",
          "items": { "$ref": "#/$defs/unidad_ronda" }
        },
        "caidas_guardadas": {
          "description": "Métrica 10 (por id de unidad). T23: null. La llena T27",
          "type": "null"
        },
        "muertes": {
          "description": "Métrica 11: las muertas del cierre, con la causa = el desenlace del fin",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unidad", "causa"],
            "additionalProperties": false,
            "properties": {
              "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
              "unidad": { "$ref": "comunes.schema.json#/$defs/id" },
              "causa": { "$ref": "comunes.schema.json#/$defs/id" }
            }
          }
        },
        "rescate": {
          "description": "Métrica 12 (sí o no, y quién rescató). T23: null. La llena T29",
          "type": "null"
        },
        "distancia_maestro": {
          "description": "Métrica 13: los distancia_maestro no nulos desde la ronda del primer ataque. Promedio = suma / turnos",
          "type": "object",
          "required": ["turnos", "suma"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "turnos": { "$ref": "#/$defs/conteo" },
            "suma": { "$ref": "#/$defs/conteo" }
          }
        },
        "activas": {
          "description": "Métrica 14: activas (por el tipo de la acción) y terreno",
          "type": "object",
          "required": ["usos", "surcos", "ocultos", "destapes_contacto", "bonos_cobrados", "bonos_perdidos", "cambios_modo", "encierros"],
          "additionalProperties": false,
          "properties": {
            "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
            "usos": {
              "description": "Solo las unidades con algún uso, en el orden del escenario",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unidad", "erizarse", "cavar", "hacerse_junco"],
                "additionalProperties": false,
                "properties": {
                  "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
                  "unidad": { "$ref": "comunes.schema.json#/$defs/id" },
                  "erizarse": { "$ref": "#/$defs/conteo" },
                  "cavar": { "$ref": "#/$defs/conteo" },
                  "hacerse_junco": { "$ref": "#/$defs/conteo" }
                }
              }
            },
            "surcos": { "$ref": "#/$defs/conteo" },
            "ocultos": { "$ref": "#/$defs/conteo" },
            "destapes_contacto": { "$ref": "#/$defs/conteo" },
            "bonos_cobrados": { "$ref": "#/$defs/conteo" },
            "bonos_perdidos": { "$ref": "#/$defs/conteo" },
            "cambios_modo": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unidad", "de", "a", "ronda"],
                "additionalProperties": false,
                "properties": {
                  "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
                  "unidad": { "$ref": "comunes.schema.json#/$defs/id" },
                  "de": { "$ref": "comunes.schema.json#/$defs/id" },
                  "a": { "$ref": "comunes.schema.json#/$defs/id" },
                  "ronda": { "$ref": "#/$defs/conteo" }
                }
              }
            },
            "encierros": {
              "description": "Turnos terminados sin ninguna casilla libre en las 4 ortogonales (evento encierro). Solo las unidades con alguno, en el orden del escenario",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unidad", "turnos"],
                "additionalProperties": false,
                "properties": {
                  "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
                  "unidad": { "$ref": "comunes.schema.json#/$defs/id" },
                  "turnos": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "conteo": {
      "type": "integer",
      "minimum": 0
    },
    "incidentes_bando": {
      "type": "object",
      "required": ["distraida", "golpe"],
      "additionalProperties": false,
      "properties": {
        "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
        "distraida": { "$ref": "#/$defs/conteo" },
        "golpe": { "$ref": "#/$defs/conteo" }
      }
    },
    "cobardia_bando": {
      "type": "object",
      "required": ["acobardada", "resistida"],
      "additionalProperties": false,
      "properties": {
        "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
        "acobardada": { "$ref": "#/$defs/conteo" },
        "resistida": { "$ref": "#/$defs/conteo" }
      }
    },
    "unidad_ronda": {
      "type": "object",
      "required": ["unidad", "ronda"],
      "additionalProperties": false,
      "properties": {
        "_nota": { "$ref": "comunes.schema.json#/$defs/nota" },
        "unidad": { "$ref": "comunes.schema.json#/$defs/id" },
        "ronda": { "$ref": "#/$defs/conteo" }
      }
    }
  }
}
