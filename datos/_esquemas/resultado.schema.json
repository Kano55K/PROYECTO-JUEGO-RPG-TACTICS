{
  "title": "Resultado de combate",
  "description": "Arquitectura.md A.7. Salida del combate. La pantalla de resultado solo lo muestra; en 0b el loop lo aplica a la partida. No es un archivo que se edite: lo escribe el núcleo (ResultadoCombate, T12). Los campos de tareas futuras van en null o lista vacía; su description dice qué tarea los llena.",
  "type": "object",
  "required": [
    "contexto_id",
    "semilla",
    "desenlace",
    "rondas",
    "maestro_caido",
    "rescatista",
    "permadeath",
    "maestro",
    "unidades",
    "levantadas",
    "muertas",
    "capturas",
    "lealtad_cambios",
    "pergaminos",
    "atacante_pendiente",
    "metricas"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_nota": {
      "$ref": "comunes.schema.json#/$defs/nota"
    },
    "contexto_id": {
      "$ref": "comunes.schema.json#/$defs/id"
    },
    "semilla": {
      "type": "integer"
    },
    "desenlace": {
      "description": "Los nombres de FinCombate y del evento fin del registro. huida: T28",
      "enum": [
        "victoria",
        "derrota_por_caida",
        "huida"
      ]
    },
    "rondas": {
      "type": "integer",
      "minimum": 0
    },
    "maestro_caido": {
      "type": "boolean"
    },
    "rescatista": {
      "description": "id de la rescatista. T12: null. Lo llena T29",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]+$"
    },
    "permadeath": {
      "description": "T12: null. Lo llena T29",
      "type": [
        "boolean",
        "null"
      ]
    },
    "maestro": {
      "type": "object",
      "required": [
        "vida",
        "posicion",
        "mana",
        "hambre"
      ],
      "additionalProperties": false,
      "properties": {
        "vida": {
          "type": "integer",
          "minimum": 0
        },
        "posicion": {
          "$ref": "comunes.schema.json#/$defs/posicion"
        },
        "mana": {
          "description": "T12: null. Lo llena T21",
          "type": [
            "integer",
            "null"
          ]
        },
        "hambre": {
          "type": "integer"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "unidades": {
      "description": "Estado final de cada criatura, en el orden del Plantel",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "especie",
          "bando",
          "estado",
          "vida",
          "lealtad",
          "hambre",
          "posicion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "especie": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "bando": {
            "enum": [
              "tribu",
              "enemiga"
            ]
          },
          "estado": {
            "enum": [
              "suelta",
              "guardada",
              "caida",
              "fuera",
              "muerta"
            ]
          },
          "vida": {
            "type": "integer",
            "minimum": 0
          },
          "lealtad": {
            "description": "null en las enemigas",
            "type": [
              "integer",
              "null"
            ]
          },
          "hambre": {
            "description": "Final, con el hambre de combate (Sistema.md 7.2, T14). null en las enemigas",
            "type": [
              "integer",
              "null"
            ]
          },
          "posicion": {
            "description": "null si no está en el tablero",
            "$ref": "comunes.schema.json#/$defs/posicion"
          },
          "_nota": {
            "$ref": "comunes.schema.json#/$defs/nota"
          }
        }
      }
    },
    "levantadas": {
      "description": "ids de las caídas de la tribu que se levantaron (victoria)",
      "type": "array",
      "items": {
        "$ref": "comunes.schema.json#/$defs/id"
      }
    },
    "muertas": {
      "description": "ids de las caídas de la tribu que murieron (derrota)",
      "type": "array",
      "items": {
        "$ref": "comunes.schema.json#/$defs/id"
      }
    },
    "capturas": {
      "description": "T12: lista vacía. La llenan T24 (sellar) y T30 (resellar)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "especie",
          "camino",
          "lealtad"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "especie": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "camino": {
            "enum": [
              "combate",
              "resellado"
            ]
          },
          "lealtad": {
            "type": "integer"
          },
          "_nota": {
            "$ref": "comunes.schema.json#/$defs/nota"
          }
        }
      }
    },
    "lealtad_cambios": {
      "description": "Lo que devuelve el acumulador de lealtad: por criatura, antes, cambio recortado una vez y después, con cada anotación y su motivo",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "antes",
          "cambio",
          "despues",
          "anotaciones"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "comunes.schema.json#/$defs/id"
          },
          "antes": {
            "type": "integer"
          },
          "cambio": {
            "type": "integer"
          },
          "despues": {
            "type": "integer"
          },
          "anotaciones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cambio",
                "motivo"
              ],
              "additionalProperties": false,
              "properties": {
                "cambio": {
                  "type": "integer"
                },
                "motivo": {
                  "description": "Las claves de tablas/lealtad.json eventos (P-019)",
                  "enum": [
                    "victoria",
                    "muerte_en_el_grupo",
                    "muerte_en_el_grupo_afines",
                    "rescate",
                    "perdon_a_leales",
                    "comer_atacante"
                  ]
                },
                "_nota": {
                  "$ref": "comunes.schema.json#/$defs/nota"
                }
              }
            }
          },
          "_nota": {
            "$ref": "comunes.schema.json#/$defs/nota"
          }
        }
      }
    },
    "pergaminos": {
      "type": "object",
      "required": [
        "en_blanco",
        "ardidos"
      ],
      "additionalProperties": false,
      "properties": {
        "en_blanco": {
          "type": "integer",
          "minimum": 0
        },
        "ardidos": {
          "description": "ids de los pergaminos que ardieron en este combate (como el evento cierre del registro)",
          "type": "array",
          "items": {
            "$ref": "comunes.schema.json#/$defs/id"
          }
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    },
    "atacante_pendiente": {
      "description": "id de la atacante nocturna caída al terminar, que espera la decisión del Maestro (perdonar, sellar, comer: T30); null si no hay",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]+$"
    },
    "metricas": {
      "description": "T12: null. Las llenan T23 y T33, desde el registro (Sistema.md 11.9)",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "secundar_usos",
        "eslabones_promedio",
        "incidentes",
        "enconos",
        "cobardias",
        "sellados_intentados",
        "sellados_logrados",
        "huidas_antes_de_sellar",
        "caidas",
        "caidas_guardadas",
        "muertes",
        "rescates",
        "distancia_media_maestro"
      ],
      "additionalProperties": false,
      "properties": {
        "secundar_usos": {
          "type": "integer"
        },
        "eslabones_promedio": {
          "type": "number"
        },
        "incidentes": {
          "type": "integer"
        },
        "enconos": {
          "type": "integer"
        },
        "cobardias": {
          "type": "integer"
        },
        "sellados_intentados": {
          "type": "integer"
        },
        "sellados_logrados": {
          "type": "integer"
        },
        "huidas_antes_de_sellar": {
          "type": "integer"
        },
        "caidas": {
          "type": "integer"
        },
        "caidas_guardadas": {
          "type": "integer"
        },
        "muertes": {
          "type": "integer"
        },
        "rescates": {
          "type": "integer"
        },
        "distancia_media_maestro": {
          "type": "number"
        },
        "_nota": {
          "$ref": "comunes.schema.json#/$defs/nota"
        }
      }
    }
  }
}
